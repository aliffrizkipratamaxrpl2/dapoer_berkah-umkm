  <diagram id="diagram_usecase" name="1. Use Case Diagram">
    <mxGraphModel dx="1400" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="960" background="#FFFFFF" math="0" shadow="0">
      <root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="uc_header" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;USE CASE DIAGRAM - APLIKASI DAPOER BERKAH UMKM&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px; color: #455A64;&quot;&gt;Alur Hak Akses 3 Peran: Admin (Pemilik Toko), Kasir (Pelayan), dan Pelanggan (Pembeli)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
      <mxGeometry x="250" y="15" width="760" height="45" as="geometry" />
    </mxCell>
<mxCell id="boundary" value="&lt;b&gt;SISTEM APLIKASI DAPOER BERKAH (FLUTTER + REST API)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#455A64;fontColor=#263238;strokeWidth=2;startSize=35;arcSize=10;rounded=1;collapsible=0;" vertex="1" parent="1">
      <mxGeometry x="270" y="80" width="720" height="840" as="geometry" />
    </mxCell>
<mxCell id="box_public" value="&lt;b style=&quot;color: #2E7D32;&quot;&gt;1. FITUR BERSAMA (Dapat Diakses Semua Pengguna)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#81C784;fontColor=#1B5E20;startSize=26;rounded=1;collapsible=0;strokeWidth=1.5;" vertex="1" parent="boundary">
      <mxGeometry x="30" y="50" width="660" height="170" as="geometry" />
    </mxCell>
<mxCell id="uc_login" value="&lt;b&gt;1. Registrasi &amp;amp; Login Akun&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #555;&quot;&gt;(Masuk sebagai Admin / Kasir / Pelanggan)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#1B5E20;" vertex="1" parent="box_public">
      <mxGeometry x="30" y="40" width="270" height="50" as="geometry" />
    </mxCell>
<mxCell id="uc_view" value="&lt;b&gt;2. Melihat Katalog Menu Makanan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #555;&quot;&gt;(Lihat nama, foto, harga, dan sisa stok)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#1B5E20;" vertex="1" parent="box_public">
      <mxGeometry x="350" y="40" width="280" height="50" as="geometry" />
    </mxCell>
<mxCell id="uc_filter" value="&lt;b&gt;3. Mencari &amp;amp; Memfilter Kategori Menu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #555;&quot;&gt;(Pilih Makanan Utama, Minuman, atau Cemilan)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#1B5E20;" vertex="1" parent="box_public">
      <mxGeometry x="180" y="105" width="300" height="50" as="geometry" />
    </mxCell>
<mxCell id="box_order" value="&lt;b style=&quot;color: #0D47A1;&quot;&gt;2. FITUR PEMBELIAN (Pelanggan &amp;amp; Kasir)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#64B5F6;fontColor=#0D47A1;startSize=26;rounded=1;collapsible=0;strokeWidth=2;" vertex="1" parent="boundary">
      <mxGeometry x="30" y="240" width="660" height="210" as="geometry" />
    </mxCell>
<mxCell id="uc_buy" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;4. Membeli Menu Makanan&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #1565C0;&quot;&gt;(Pilih jumlah porsi &amp;amp; konfirmasi pemesanan)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;strokeWidth=2;fontColor=#0D47A1;" vertex="1" parent="box_order">
      <mxGeometry x="40" y="65" width="270" height="60" as="geometry" />
    </mxCell>
<mxCell id="uc_stock" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;5. Mengurangi Stok Otomatis&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #B71C1C;&quot;&gt;(Database Aiven: Stok Baru = Stok - Jumlah Beli)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=2;fontColor=#BF360C;" vertex="1" parent="box_order">
      <mxGeometry x="350" y="65" width="280" height="60" as="geometry" />
    </mxCell>
<mxCell id="inc_buy_stock" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="edgeStyle=orthogonalEdgeStyle;dashed=1;html=1;endArrow=open;strokeWidth=2;strokeColor=#1976D2;fontColor=#0D47A1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="box_order" source="uc_buy" target="uc_stock">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
<mxCell id="note_buy" value="&lt;i&gt;*Setiap kali tombol Beli ditekan, sistem langsung mengecek stok dan memotong stok di database secara otomatis.*&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#455A64;" vertex="1" parent="box_order">
      <mxGeometry x="30" y="155" width="600" height="30" as="geometry" />
    </mxCell>
<mxCell id="box_admin" value="&lt;b style=&quot;color: #D84315;&quot;&gt;3. FITUR KELOLA RESTORAN (Khusus Hak Akses Role Admin)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FFB74D;fontColor=#BF360C;startSize=26;rounded=1;collapsible=0;strokeWidth=1.5;" vertex="1" parent="boundary">
      <mxGeometry x="30" y="470" width="660" height="340" as="geometry" />
    </mxCell>
<mxCell id="uc_add" value="&lt;b&gt;6. Menambah Menu Baru &amp;amp; Upload Foto&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #555;&quot;&gt;(Input nama makanan, harga, stok, dan foto kamera/galeri)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#BF360C;" vertex="1" parent="box_admin">
      <mxGeometry x="30" y="45" width="300" height="55" as="geometry" />
    </mxCell>
<mxCell id="uc_edit" value="&lt;b&gt;7. Mengubah Data &amp;amp; Update Stok Menu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #555;&quot;&gt;(Ganti harga, ubah nama, atau restock barang)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#BF360C;" vertex="1" parent="box_admin">
      <mxGeometry x="350" y="45" width="290" height="55" as="geometry" />
    </mxCell>
<mxCell id="uc_del" value="&lt;b&gt;8. Menghapus Menu Makanan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #555;&quot;&gt;(Konfirmasi dialog 'Yakin hapus?' &amp;amp; hapus foto fisik)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#E53935;strokeWidth=1.5;fontColor=#C62828;" vertex="1" parent="box_admin">
      <mxGeometry x="30" y="125" width="300" height="55" as="geometry" />
    </mxCell>
<mxCell id="uc_cat" value="&lt;b&gt;9. Mengelola Master Kategori Menu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #555;&quot;&gt;(Tambah, edit, dan hapus kategori makanan/minuman)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#BF360C;" vertex="1" parent="box_admin">
      <mxGeometry x="350" y="125" width="290" height="55" as="geometry" />
    </mxCell>
<mxCell id="uc_dash" value="&lt;b&gt;10. Memantau Dashboard &amp;amp; Peringatan Stok Menipis&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #555;&quot;&gt;(Melihat total item menu &amp;amp; daftar stok &amp;lt; 10 porsi)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#BF360C;" vertex="1" parent="box_admin">
      <mxGeometry x="150" y="205" width="370" height="55" as="geometry" />
    </mxCell>
<mxCell id="uc_logout" value="&lt;b&gt;11. Logout Akun&lt;/b&gt; (Hapus Sesi Login)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#78909C;strokeWidth=1;fontColor=#37474F;" vertex="1" parent="box_admin">
      <mxGeometry x="235" y="275" width="200" height="45" as="geometry" />
    </mxCell>
<mxCell id="actor_admin" value="&lt;b&gt;ADMIN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #E65100;&quot;&gt;Pemilik UMKM&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFE082;strokeColor=#FF8F00;strokeWidth=2.5;fontColor=#BF360C;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="70" y="550" width="60" height="110" as="geometry" />
    </mxCell>
<mxCell id="actor_kasir" value="&lt;b&gt;KASIR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #2E7D32;&quot;&gt;Staf Kasir&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#C8E6C9;strokeColor=#388E3C;strokeWidth=2.5;fontColor=#1B5E20;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="70" y="320" width="60" height="110" as="geometry" />
    </mxCell>
<mxCell id="actor_pelanggan" value="&lt;b&gt;PELANGGAN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #1565C0;&quot;&gt;Pembeli / Konsumen&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#BBDEFB;strokeColor=#1976D2;strokeWidth=2.5;fontColor=#0D47A1;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="70" y="130" width="60" height="110" as="geometry" />
    </mxCell>
<mxCell id="edge_plg_box1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=none;strokeColor=#1976D2;strokeWidth=2;" edge="1" parent="1" source="actor_pelanggan" target="box_public"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="edge_plg_box2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.3;entryDx=0;entryDy=0;endArrow=none;strokeColor=#1976D2;strokeWidth=2.5;" edge="1" parent="1" source="actor_pelanggan" target="box_order"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="edge_ksr_box1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.7;entryDx=0;entryDy=0;endArrow=none;strokeColor=#2E7D32;strokeWidth=2;" edge="1" parent="1" source="actor_kasir" target="box_public"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="edge_ksr_box2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.6;entryDx=0;entryDy=0;endArrow=none;strokeColor=#2E7D32;strokeWidth=2;" edge="1" parent="1" source="actor_kasir" target="box_order"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="edge_adm_box1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.9;entryDx=0;entryDy=0;endArrow=none;strokeColor=#FF8F00;strokeWidth=1.5;" edge="1" parent="1" source="actor_admin" target="box_public"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="580"/><mxPoint x="180" y="210"/></Array></mxGeometry></mxCell>
<mxCell id="edge_adm_box2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.8;entryDx=0;entryDy=0;endArrow=none;strokeColor=#FF8F00;strokeWidth=1.5;" edge="1" parent="1" source="actor_admin" target="box_order"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="600"/><mxPoint x="200" y="440"/></Array></mxGeometry></mxCell>
<mxCell id="edge_adm_box3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=none;strokeColor=#FF8F00;strokeWidth=3;" edge="1" parent="1" source="actor_admin" target="box_admin"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="card_guide" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px; color: #D84315;&quot;&gt;💡 CONTEKAN PRESENTASI KE PENGUJI&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;br&gt;&lt;b style=&quot;color: #0D47A1;&quot;&gt;1. Pelanggan (Konsumen):&lt;/b&gt;&lt;br&gt;Bisa mendaftar akun, membuka katalog menu, memilih makanan, dan &lt;b&gt;membeli secara langsung&lt;/b&gt;. Saat tombol beli ditekan, stok makanan di database otomatis berkurang.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color: #2E7D32;&quot;&gt;2. Kasir (Pelayan):&lt;/b&gt;&lt;br&gt;Bisa melihat menu makanan dan membantu memesankan pesanan jika pembeli bertransaksi langsung di kasir toko.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color: #E65100;&quot;&gt;3. Admin (Pemilik Usaha):&lt;/b&gt;&lt;br&gt;Memiliki hak akses penuh untuk &lt;b&gt;menambah menu baru beserta foto&lt;/b&gt;, mengubah harga/stok, menghapus menu, dan mengatur kategori kuliner.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color: #C62828;&quot;&gt;★ Keunggulan Sistem:&lt;/b&gt;&lt;br&gt;Stok dihitung real-time. Jika stok tersisa 0, sistem otomatis mengunci tombol beli agar pesanan tidak melebihi stok yang ada." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFDE7;strokeColor=#FBC02D;fontColor=#263238;align=left;verticalAlign=top;spacingLeft=12;spacingTop=12;spacingRight=12;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="1030" y="110" width="340" height="780" as="geometry" />
    </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>