    </mxCell>
<mxCell id="f_prod_fields" value="FK | category_id : INT NOT NULL (Ref: categories.id)&#xa;   name : VARCHAR(150) NOT NULL&#xa;   description : TEXT NULL&#xa;   price : DECIMAL(12,2) DEFAULT 0.00&#xa;   stock : INT DEFAULT 0&#xa;   image_url : VARCHAR(255) NULL (Nama File)&#xa;   created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP&#xa;   updated_at : TIMESTAMP ON UPDATE CURRENT_TIMESTAMP" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;overflow=hidden;rotatable=0;" vertex="1" parent="ent_products">
      <mxGeometry y="60" width="340" height="210" as="geometry" />
    </mxCell>
<mxCell id="rel_cat_prod_erd" value="1                                         0..*&#xa;menaungi (ON DELETE CASCADE)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;strokeWidth=2;strokeColor=#D84315;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="ent_categories" target="ent_products">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
<mxCell id="erd_note" value="&lt;b&gt;PENJELASAN INTEGRITAS DATA &amp;amp; KARDINALITAS RELASI:&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;b&gt;One-to-Many (1 : N)&lt;/b&gt;: Satu record kategori (misal: &lt;i&gt;Makanan Utama&lt;/i&gt;) menaungi banyak item hidangan &lt;code&gt;products&lt;/code&gt;.&lt;br&gt;2. &lt;b&gt;Foreign Key Constraint&lt;/b&gt;: &lt;code&gt;products.category_id&lt;/code&gt; mereferensikan &lt;code&gt;categories.id&lt;/code&gt;.&lt;br&gt;3. &lt;b&gt;ON DELETE CASCADE&lt;/b&gt;: Jika suatu kategori dihapus, seluruh produk di bawahnya ikut terhapus secara otomatis.&lt;br&gt;4. &lt;b&gt;ON UPDATE CASCADE&lt;/b&gt;: Perubahan id kategori secara otomatis tersinkronisasi ke seluruh foreign key produk.&lt;br&gt;5. &lt;b&gt;Keamanan Akun&lt;/b&gt;: Password pengguna di tabel &lt;code&gt;users&lt;/code&gt; dienkripsi satu arah dengan algoritma hashing &lt;b&gt;Bcrypt (10 salt rounds)&lt;/b&gt;." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFDE7;strokeColor=#FBC02D;fontColor=#37474F;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;" vertex="1" parent="1">
      <mxGeometry x="180" y="420" width="880" height="150" as="geometry" />
    </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
