    </mxCell>
<mxCell id="fu_pk" value="PK | id : INT (Nomor Unik Akun)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;overflow=hidden;rotatable=0;fontStyle=1;fontColor=#B71C1C;" vertex="1" parent="ent_users">
