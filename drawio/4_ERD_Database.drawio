<mxCell id="erd_title" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;ENTITY RELATIONSHIP DIAGRAM (ERD) - DATABASE DAPOER BERKAH&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px; color: #546E7A;&quot;&gt;MySQL Database pada Aiven Cloud dengan Dukungan Role Pelanggan &amp;amp; Pengurangan Stok Otomatis&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
