<mxCell id="erd_title" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;ENTITY RELATIONSHIP DIAGRAM (ERD) - DATABASE DAPOER BERKAH&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px; color: #455A64;&quot;&gt;Struktur Relasi 3 Tabel MySQL pada Aiven Cloud: Akun Pengguna, Kategori, dan Produk Kuliner&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
      <mxGeometry x="250" y="15" width="850" height="45" as="geometry" />
    </mxCell>
<mxCell id="ent_users" value="&lt;b&gt;users&lt;/b&gt; (Tabel Akun &amp;amp; Hak Akses)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#E8EAF6;strokeColor=#3F51B5;fontColor=#1A237E;strokeWidth=1.5;" vertex="1" parent="1">
