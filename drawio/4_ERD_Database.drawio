<mxCell id="fu_line" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;" vertex="1" parent="ent_users"><mxGeometry y="54" width="340" height="6" as="geometry" /></mxCell>
<mxCell id="fu_body" value="   name : VARCHAR(100) (Nama Lengkap)&#xa;UK | email : VARCHAR(100) (Email Login - Unik)&#xa;   password : VARCHAR(255) (Enkripsi Bcrypt)&#xa;&lt;b style=&quot;color: #0D47A1;&quot;&gt;   role : ENUM('admin', 'kasir', 'pelanggan')&lt;/b&gt;&#xa;   created_at : TIMESTAMP (Tanggal Daftar)&#xa;   updated_at : TIMESTAMP (Tanggal Ubah)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;overflow=hidden;rotatable=0;html=1;" vertex="1" parent="ent_users">
      <mxGeometry y="60" width="340" height="190" as="geometry" />
    </mxCell>
<mxCell id="ent_categories" value="&lt;b&gt;categories&lt;/b&gt; (Tabel Jenis Kuliner)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;fontColor=#1B5E20;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="460" y="90" width="330" height="220" as="geometry" />
    </mxCell>
<mxCell id="fc_pk" value="PK | id : INT (Nomor Unik Kategori)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;overflow=hidden;rotatable=0;fontStyle=1;fontColor=#B71C1C;" vertex="1" parent="ent_categories">
      <mxGeometry y="28" width="330" height="26" as="geometry" />
    </mxCell>
<mxCell id="fc_line" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;" vertex="1" parent="ent_categories"><mxGeometry y="54" width="330" height="6" as="geometry" /></mxCell>
<mxCell id="fc_body" value="   name : VARCHAR(100) (Nama Kategori)&#xa;   description : TEXT (Keterangan Jenis Makanan)&#xa;   created_at : TIMESTAMP (Waktu Dibuat)&#xa;   updated_at : TIMESTAMP (Waktu Diperbarui)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;overflow=hidden;rotatable=0;" vertex="1" parent="ent_categories">
      <mxGeometry y="60" width="330" height="160" as="geometry" />
    </mxCell>
<mxCell id="ent_products" value="&lt;b&gt;products&lt;/b&gt; (Tabel Menu &amp;amp; Sisa Stok)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#FFF3E0;strokeColor=#F57C00;fontColor=#E65100;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="870" y="90" width="390" height="280" as="geometry" />
    </mxCell>
<mxCell id="fp_pk" value="PK | id : INT (Nomor Unik Produk)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;overflow=hidden;rotatable=0;fontStyle=1;fontColor=#B71C1C;" vertex="1" parent="ent_products">
      <mxGeometry y="28" width="390" height="26" as="geometry" />
    </mxCell>
<mxCell id="fp_line" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;" vertex="1" parent="ent_products"><mxGeometry y="54" width="390" height="6" as="geometry" /></mxCell>
<mxCell id="fp_body" value="FK | category_id : INT (Relasi ke categories.id)&#xa;   name : VARCHAR(150) (Nama Makanan/Minuman)&#xa;   description : TEXT (Penjelasan Menu)&#xa;   price : DECIMAL(12,2) (Harga Jual Rp)&#xa;&lt;b style=&quot;color: #D84315;&quot;&gt;   stock : INT DEFAULT 0 (Stok Porsi Tersedia)&lt;/b&gt;&#xa;   image_url : VARCHAR(255) (Nama File Foto Menu)&#xa;   created_at : TIMESTAMP (Tanggal Ditambahkan)&#xa;   updated_at : TIMESTAMP (Tanggal Terakhir Diubah)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;overflow=hidden;rotatable=0;html=1;" vertex="1" parent="ent_products">
      <mxGeometry y="60" width="390" height="220" as="geometry" />
    </mxCell>
<mxCell id="rel_erd" value="1 (Satu Kategori)              0..* (Banyak Menu)&#xa;Menaungi (ON DELETE CASCADE)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;strokeWidth=2.5;strokeColor=#D84315;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="ent_categories" target="ent_products">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
<mxCell id="erd_explain" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px; color: #D84315;&quot;&gt;💡 CONTEKAN TEKNIS DATABASE UNTUK UJI LEVEL:&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;br&gt;&lt;b&gt;1. Mengapa Cukup 3 Tabel?&lt;/b&gt;&lt;br&gt;Sistem UMKM Dapoer Berkah dirancang ramping dan cepat: tabel &lt;b&gt;users&lt;/b&gt; mencatat hak akses pengguna, &lt;b&gt;categories&lt;/b&gt; mengelompokkan makanan, dan &lt;b&gt;products&lt;/b&gt; menyimpan menu beserta sisa stok.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Bagaimana Cara Stok Berkurang Otomatis Saat Pelanggan Beli?&lt;/b&gt;&lt;br&gt;Ketika Pelanggan menekan tombol 'Beli', backend menjalankan perintah SQL:&lt;br&gt;&lt;font style=&quot;color: #D84315; font-family: monospace;&quot;&gt;&lt;b&gt;UPDATE products SET stock = stock - ? WHERE id = ?&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Sehingga jika stok awal 10 dan dibeli 2 porsi, stok di database langsung berubah menjadi 8 secara otomatis.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Relasi Tabel (1 : N):&lt;/b&gt;&lt;br&gt;Satu kategori (misal: 'Makanan Utama') bisa memiliki banyak item menu kuliner (Nasi Goreng, Ayam Bakar, dll).&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Keamanan Akun:&lt;/b&gt;&lt;br&gt;Password pengguna tidak disimpan sebagai teks biasa, melainkan dienkripsi satu arah menggunakan &lt;b&gt;Bcrypt (10 salt rounds)&lt;/b&gt; demi keamanan data." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFDE7;strokeColor=#FBC02D;fontColor=#263238;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;spacingRight=12;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="120" y="420" width="1050" height="280" as="geometry" />
    </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>