      <mxGeometry y="54" width="340" height="6" as="geometry" />
    </mxCell>
<mxCell id="f_users_fields" value="   name : VARCHAR(100) NOT NULL&#xa;UK | email : VARCHAR(100) NOT NULL UNIQUE&#xa;   password : VARCHAR(255) NOT NULL (Bcrypt)&#xa;&lt;b style=&quot;color: #0D47A1;&quot;&gt;   role : ENUM('admin','kasir','pelanggan') DEFAULT 'pelanggan'&lt;/b&gt;&#xa;   created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP&#xa;   updated_at : TIMESTAMP ON UPDATE CURRENT_TIMESTAMP" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;overflow=hidden;rotatable=0;html=1;" vertex="1" parent="ent_users">
      <mxGeometry y="60" width="340" height="180" as="geometry" />
    </mxCell>
