<mxCell id="step1_log" value="&lt;b&gt;Langkah 1: Buka Aplikasi Dapoer Berkah&lt;/b&gt;&lt;br&gt;Tampil form login dan pilihan tombol uji coba cepat (Admin/Kasir)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4CAF50;arcSize=15;strokeWidth=1.5;" vertex="1" parent="lane_login">
