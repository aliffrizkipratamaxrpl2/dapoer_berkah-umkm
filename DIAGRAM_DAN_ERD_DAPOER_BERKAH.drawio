      <mxGeometry x="460" y="100" width="310" height="210" as="geometry" />
    </mxCell>
<mxCell id="f_cat_1" value="PK | id : INT (AUTO_INCREMENT)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;overflow=hidden;rotatable=0;fontStyle=1;fontColor=#B71C1C;" vertex="1" parent="ent_categories">
      <mxGeometry y="28" width="310" height="26" as="geometry" />
    </mxCell>
<mxCell id="f_cat_div1" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;" vertex="1" parent="ent_categories">
      <mxGeometry y="54" width="310" height="6" as="geometry" />
    </mxCell>
<mxCell id="f_cat_fields" value="   name : VARCHAR(100) NOT NULL&#xa;   description : TEXT NULL&#xa;   created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP&#xa;   updated_at : TIMESTAMP ON UPDATE CURRENT_TIMESTAMP" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;overflow=hidden;rotatable=0;" vertex="1" parent="ent_categories">
      <mxGeometry y="60" width="310" height="150" as="geometry" />
    </mxCell>
<mxCell id="ent_products" value="&lt;b&gt;products&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#FFF3E0;strokeColor=#F57C00;fontColor=#E65100;" vertex="1" parent="1">
      <mxGeometry x="880" y="100" width="360" height="280" as="geometry" />
    </mxCell>
<mxCell id="f_prod_1" value="PK | id : INT (AUTO_INCREMENT)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;overflow=hidden;rotatable=0;fontStyle=1;fontColor=#B71C1C;" vertex="1" parent="ent_products">
      <mxGeometry y="28" width="360" height="26" as="geometry" />
    </mxCell>
<mxCell id="f_prod_div1" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;" vertex="1" parent="ent_products">
      <mxGeometry y="54" width="360" height="6" as="geometry" />
    </mxCell>
<mxCell id="f_prod_fields" value="FK | category_id : INT NOT NULL (Ref: categories.id)&#xa;   name : VARCHAR(150) NOT NULL&#xa;   description : TEXT NULL&#xa;   price : DECIMAL(12,2) DEFAULT 0.00&#xa;&lt;b style=&quot;color: #D84315;&quot;&gt;   stock : INT DEFAULT 0 (Berkurang saat Beli)&lt;/b&gt;&#xa;   image_url : VARCHAR(255) NULL (Nama File)&#xa;   created_at : TIMESTAMP DEFAULT CURRENT_TIMESTAMP&#xa;   updated_at : TIMESTAMP ON UPDATE CURRENT_TIMESTAMP" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;overflow=hidden;rotatable=0;html=1;" vertex="1" parent="ent_products">
      <mxGeometry y="60" width="360" height="220" as="geometry" />
    </mxCell>
<mxCell id="rel_cat_prod_erd" value="1                                         0..*&#xa;menaungi (ON DELETE CASCADE)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;strokeWidth=2;strokeColor=#D84315;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="ent_categories" target="ent_products">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
<mxCell id="erd_note" value="&lt;b&gt;PENJELASAN INTEGRITAS DATA &amp;amp; PENGURANGAN STOK OTOMATIS:&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;b&gt;Role Pengguna (users)&lt;/b&gt;: Mendukung 3 hak akses: &lt;b&gt;admin&lt;/b&gt; (CRUD Penuh), &lt;b&gt;kasir&lt;/b&gt; (Cek stok &amp;amp; Pelayanan), dan &lt;b&gt;pelanggan&lt;/b&gt; (Pemesanan/Pembelian).&lt;br&gt;2. &lt;b&gt;Pengurangan Stok Otomatis (products.stock)&lt;/b&gt;: Saat endpoint &lt;code&gt;POST /api/products/:id/buy&lt;/code&gt; dieksekusi oleh Pelanggan, sistem mengecek stok tersisa lalu menjalankan operasi &lt;code&gt;UPDATE products SET stock = stock - quantity WHERE id = ?&lt;/code&gt;.&lt;br&gt;3. &lt;b&gt;One-to-Many (1 : N)&lt;/b&gt;: Satu record kategori menaungi banyak item produk hidangan kuliner.&lt;br&gt;4. &lt;b&gt;Foreign Key Constraint&lt;/b&gt;: Kolom &lt;code&gt;products.category_id&lt;/code&gt; mereferensikan &lt;code&gt;categories.id&lt;/code&gt; dengan aturan &lt;b&gt;ON DELETE CASCADE&lt;/b&gt;.&lt;br&gt;5. &lt;b&gt;Enkripsi Akun&lt;/b&gt;: Password seluruh akun pengguna di-hash satu arah menggunakan algoritma &lt;b&gt;Bcrypt (10 salt rounds)&lt;/b&gt;." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFDE7;strokeColor=#FBC02D;fontColor=#37474F;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;" vertex="1" parent="1">
      <mxGeometry x="180" y="420" width="940" height="160" as="geometry" />
    </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>